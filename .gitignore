node_modules/
dist/
coverage/

# Секреты — только через переменные окружения, никогда в репозиторий.
.env
.env.*
!.env.example

# Прогоны инструмента: могут содержать PII клиента.
*.report.json
*.report.html
/runs/

# Локальные правила: содержат внутренние названия, которым не место
# в публичном репозитории.
.claude/**/_local/

# Рабочие деревья, создаваемые агентами внутри репозитория.
.claude/worktrees/

# Русские версии документов и сообщений. Источник правды — английские файлы
# в репозитории; здесь лежит снимок на память владельцу. В git не идёт
# намеренно: две языковые версии расходятся при первой же правке, и молчаливое
# расхождение — ровно то, с чем этот инструмент борется.
/_local/

.DS_Store
*.log
