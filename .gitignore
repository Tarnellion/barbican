node_modules/
dist/
coverage/

# Secrets go through environment variables only, never into the repository.
.env
.env.*
!.env.example

# Tool runs: they may carry a customer's personal data.
*.report.json
*.report.html
/runs/

# Local rules: they carry internal names that have no place in a public
# repository.
.claude/**/_local/

# The local Claude settings: a per-machine file with permissions and paths, kept
# out of a public repository. It was excluded only by the owner's global ignore,
# which is not part of the repository and does not travel with a clone — so on
# any other machine it would have been committed. Found by the audit of
# 14 August 2026 (L-10).
.claude/settings.local.json

# Worktrees created by agents inside the repository.
.claude/worktrees/

# Russian versions of the documents and messages. The source of truth is the
# English files in the repository; what lies here is a snapshot kept for the
# owner. It stays out of git deliberately: two language versions drift apart at
# the first edit, and a silent drift is exactly what this tool fights.
/_local/

.DS_Store
*.log
