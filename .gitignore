node_modules/
dist/
coverage/

# Секреты — только через переменные окружения, никогда в репозиторий.
.env
.env.*
!.env.example

# Прогоны инструмента: могут содержать PII клиента.
*.report.json
*.report.html
/runs/

# Локальные правила: содержат внутренние названия, которым не место
# в публичном репозитории.
.claude/**/_local/

# Рабочие деревья, создаваемые агентами внутри репозитория.
.claude/worktrees/

.DS_Store
*.log
