{
  "name": "barbican",
  "version": "0.0.1",
  "description": "CLI harness for testing RBAC and tenant isolation in multi-tenant APIs.",
  "keywords": [
    "rbac",
    "tenant-isolation",
    "bola",
    "idor",
    "api-security",
    "openapi"
  ],
  "license": "Apache-2.0",
  "author": "Taras Govorukha (https://github.com/Tarnellion)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tarnellion/barbican.git"
  },
  "homepage": "https://github.com/Tarnellion/barbican#readme",
  "bugs": {
    "url": "https://github.com/Tarnellion/barbican/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "barbican": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "hooks:install": "lefthook install"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "commander": "15.0.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "lefthook": "2.1.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
