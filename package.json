{
  "name": "barbican",
  "version": "0.4.0",
  "description": "CLI harness for testing RBAC and tenant isolation in multi-tenant APIs.",
  "keywords": [
    "rbac",
    "tenant-isolation",
    "bola",
    "idor",
    "api-security",
    "openapi"
  ],
  "license": "Apache-2.0",
  "author": "Taras Govorukha (https://github.com/Tarnellion)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tarnellion/barbican.git"
  },
  "homepage": "https://github.com/Tarnellion/barbican#readme",
  "bugs": {
    "url": "https://github.com/Tarnellion/barbican/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "barbican": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "schema",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "unreviewed"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json && node tools/executable-bit.mjs",
    "schema": "node dist/cli.js schema > schema/barbican.run.schema.json && biome check --write schema",
    "deps:behind": "node tools/dependency-cooldown.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build",
    "hooks:install": "lefthook install"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "commander": "15.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "lefthook": "2.1.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
