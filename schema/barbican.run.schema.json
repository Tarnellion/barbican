{
  "$id": "https://raw.githubusercontent.com/Tarnellion/barbican/main/schema/barbican.run.schema.json",
  "title": "barbican run configuration",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "target": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "allowedHosts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["baseUrl", "allowedHosts"]
    },
    "accounts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "tenant": {
            "type": "string",
            "minLength": 1
          },
          "tenants": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tokenEnv": {
            "type": "string",
            "minLength": 1
          },
          "canary": {
            "type": "string",
            "minLength": 1
          },
          "authScheme": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "role"]
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "fallback": {
          "type": "string",
          "enum": ["allowed", "denied"]
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "roles": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "*"
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "endpoints": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "*"
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "object",
                          "properties": {
                            "method": {
                              "type": "string",
                              "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
                            },
                            "path": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": ["path"]
                        }
                      ]
                    }
                  }
                ]
              },
              "scope": {
                "type": "string",
                "enum": [
                  "own",
                  "same-tenant",
                  "descendant-tenant",
                  "ancestor-tenant",
                  "foreign-tenant"
                ]
              },
              "context": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "type": "string",
                "enum": ["allowed", "denied"]
              }
            },
            "required": ["roles", "endpoints", "outcome"],
            "additionalProperties": false
          }
        }
      },
      "required": ["fallback", "rules"]
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tenant": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "query": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "endpoints": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["id", "tenant"]
      }
    },
    "tenants": {
      "anyOf": [
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "parent": {
                "type": "string",
                "minLength": 1
              },
              "baseUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["id"]
          }
        }
      ]
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bearer"
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "header"
            },
            "header": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "header"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cookie"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "name"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "basic"
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        }
      ]
    },
    "authSchemes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "bearer"
              }
            },
            "required": ["kind"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "header"
              },
              "header": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["kind", "header"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "cookie"
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["kind", "name"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "basic"
              }
            },
            "required": ["kind"],
            "additionalProperties": false
          }
        ]
      }
    },
    "contexts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "headers": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "env": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["env"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "query": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "endpoints": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "accounts": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["id", "endpoints"],
        "additionalProperties": false
      }
    },
    "bodySignals": {
      "type": "object",
      "properties": {
        "responseMustDifferByTenant": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxBodyBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "signals": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": ["count", "present"]
              },
              "path": {
                "type": "string"
              },
              "endpoints": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["name", "kind", "path", "endpoints"]
          }
        }
      },
      "required": ["responseMustDifferByTenant"]
    }
  },
  "required": ["target", "accounts", "policy"]
}
